# ==========================================
# IRP Discord Bot Configuration & Secrets
# ==========================================

# Discord Bot Token (From Discord Developer Portal -> Bot -> Token)
DISCORD_BOT_TOKEN=""

# Primary LLM Provider: Groq API Key (Free tier at https://console.groq.com)
GROQ_API_KEY=""

# Secondary LLM Provider: Google Gemini API Key (Free tier at https://aistudio.google.com)
GEMINI_API_KEY=""

# Tertiary LLM Provider: OpenRouter API Key (Free models at https://openrouter.ai)
OPENROUTER_API_KEY=""

# Web Search Provider: Tavily Search API Key (Free tier at https://tavily.com)
TAVILY_API_KEY=""

# Persistent Memory: Turso Database URL (e.g. libsql://your-db-org.turso.io or file:irp_memory.db)
TURSO_DATABASE_URL=""

# Turso Database Auth Token (From `turso db tokens create <db-name>`)
TURSO_AUTH_TOKEN=""

# Bot Settings
COOLDOWN_SECONDS="12"
MAX_HISTORY_PER_CHANNEL="150"

